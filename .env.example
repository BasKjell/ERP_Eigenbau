# Gemeinsame Demo-Konfiguration. Vor dem ersten Start optional nach .env kopieren.
TZ=Europe/Berlin
DEMO_API_PORT=8088
DOCS_PORT=8001
ERPNEXT_PORT=8081
PAPERLESS_PORT=8010
KEYCLOAK_PORT=8082
GRAFANA_PORT=3000
MCP_PORT=8090

# Nur fuer die lokale Management-Demo - vor echtem Einsatz unbedingt aendern.
DEMO_DB_NAME=platform_demo
DEMO_DB_USER=platform
DEMO_DB_PASSWORD=platform-demo-change-me
PAPERLESS_DB_PASSWORD=paperless-demo-change-me
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=admin-demo-change-me
PAPERLESS_SECRET_KEY=replace-with-a-long-random-value
ERPNEXT_DB_ROOT_PASSWORD=erpnext-demo-change-me
ERPNEXT_ADMIN_PASSWORD=admin-demo-change-me
ERPNEXT_USERNAME=Administrator
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-demo-change-me
GRAFANA_ADMIN_PASSWORD=admin-demo-change-me

# Optional: lokales LLM auf dem Mac. Fuer den Ollama-Compose-Service stattdessen
# OLLAMA_BASE_URL=http://ollama:11434 verwenden.
AI_MODE=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# Optionale echte Systemanbindungen (Demo verwendet standardmaessig simulierte Adapter).
ERPNEXT_BASE_URL=http://erpnext-frontend:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
MCP_WRITE_ENABLED=true
MCP_MAX_WRITE_RECORDS=100
MCP_DEFAULT_COMPANY=Open Manufacturing Demo GmbH
PAPERLESS_BASE_URL=http://paperless-webserver:8000
PAPERLESS_API_TOKEN=
