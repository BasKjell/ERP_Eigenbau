# Gemeinsame Demo-Konfiguration. Vor dem ersten Start optional nach .env kopieren.
TZ=Europe/Berlin
DEMO_API_PORT=8088
DOCS_PORT=8001
ERPNEXT_PORT=8081
PAPERLESS_PORT=8010
KEYCLOAK_PORT=8082
GRAFANA_PORT=3000
MCP_PORT=8090
DMS_MCP_PORT=8091
KNOWLEDGE_MCP_PORT=8092
OPEN_WEBUI_PORT=3001
AGENTGATEWAY_UI_PORT=4001
AGENTGATEWAY_UI_PUBLIC_URL=http://localhost:4001
REDMINE_PORT=8011
DOCUMENTATION_PUBLIC_URL=http://localhost:8001
ERPNEXT_PUBLIC_URL=http://localhost:8081
PAPERLESS_PUBLIC_URL=http://localhost:8010

# Nur fuer die lokale Management-Demo - vor echtem Einsatz unbedingt aendern.
DEMO_DB_NAME=platform_demo
DEMO_DB_USER=platform
DEMO_DB_PASSWORD=platform-demo-change-me
PAPERLESS_DB_PASSWORD=paperless-demo-change-me
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=admin-demo-change-me
PAPERLESS_SECRET_KEY=replace-with-a-long-random-value
ERPNEXT_DB_ROOT_PASSWORD=erpnext-demo-change-me
ERPNEXT_ADMIN_PASSWORD=admin-demo-change-me
ERPNEXT_OIDC_CLIENT_SECRET=erpnext-oidc-demo-change-me
AGENTGATEWAY_OIDC_CLIENT_SECRET=agentgateway-oidc-demo-change-me
AGENTGATEWAY_OIDC_COOKIE_SECRET=c69b97a25b12a2dbd96bb161dd582365e3ceb597b83dd0cc902b4dda3f88ec64
AGENTGATEWAY_SESSION_KEY=02183306b4f9f14e3b3ea4eef718f9ad3aebeda74b4f34275b3dfa7702475234
ERPNEXT_USERNAME=Administrator
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-demo-change-me
KEYCLOAK_PUBLIC_URL=http://localhost:8082
GRAFANA_ADMIN_PASSWORD=admin-demo-change-me
GRAFANA_PAPERLESS_DB_PASSWORD=grafana-paperless-demo-change-me
GRAFANA_MANAGEMENT_DB_PASSWORD=grafana-management-demo-change-me
GRAFANA_PUBLIC_URL=http://localhost:3000
REDMINE_DB_PASSWORD=redmine-demo-change-me
REDMINE_ADMIN_PASSWORD=admin-demo-change-me
REDMINE_SECRET_KEY_BASE=local-redmine-secret-change-before-network-use

# Zentrale Anmeldung. Die Make-Ziele starten die Demo mit Keycloak-SSO.
# `demo` ist nur noch fuer isolierte Tests ohne zentrale Anmeldung gedacht.
AUTH_MODE=demo
AUTH_SESSION_SECRET=local-session-secret-change-before-network-use
AUTH_SESSION_MINUTES=480
AUTH_COOKIE_SECURE=false
PLATFORM_DEMO_ADMIN_TOKEN=local-demo-admin-token-change-before-network-use
REPORTING_API_TOKEN=local-reporting-token-change-before-network-use
PLATFORM_PUBLIC_URL=http://localhost:8088
OIDC_EXTERNAL_ISSUER=http://localhost:8082/realms/open-manufacturing
GRAFANA_OIDC_ENABLED=false
GRAFANA_OIDC_AUTO_LOGIN=true
# Lokalen Grafana-Login als Notfallzugang sichtbar lassen.
GRAFANA_DISABLE_LOGIN_FORM=false

# Optional: lokales LLM auf dem Mac. Fuer den Ollama-Compose-Service stattdessen
# OLLAMA_BASE_URL=http://ollama:11434 verwenden.
AI_MODE=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
# FLOWAI greift nicht mehr direkt auf Ollama zu. FLOWGATE erzwingt den
# eingeschraenkten Dienstschluessel und leitet anschliessend an Ollama weiter.
AGENTGATEWAY_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
AGENTGATEWAY_OPENWEBUI_KEY=agw-demo-openwebui-change-before-network-use
OPEN_WEBUI_SECRET_KEY=local-open-webui-demo-secret-change-before-network-use

# Optionale echte Systemanbindungen (Demo verwendet standardmaessig simulierte Adapter).
ERPNEXT_BASE_URL=http://erpnext-frontend:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
MCP_WRITE_ENABLED=true
MCP_MAX_WRITE_RECORDS=100
MCP_DEFAULT_COMPANY=Open Manufacturing Demo GmbH
PAPERLESS_BASE_URL=http://paperless-webserver:8000
PAPERLESS_API_TOKEN=
KNOWLEDGE_DATABASE_URL=postgresql://platform:platform-demo-change-me@demo-db:5432/platform_demo
DMS_EMBEDDING_DIMENSIONS=768
DMS_EMBEDDING_MODEL=flow-hash-de-768-v1
REDMINE_BASE_URL=http://redmine:3000
REDMINE_PUBLIC_URL=http://localhost:8011
# Der feste Schlüssel ist nur für die lokale Demo. Im Livebetrieb geheim erzeugen.
REDMINE_API_KEY=f6ab4d1c02fe9a7b3e5d8c4f1a6b9e2c7d0f3a5b

# Host-URLs für die API-basierten Demo-Setup-/Cleanup-Skripte.
PLATFORM_API_URL=http://localhost:8088
ERPNEXT_API_URL=http://localhost:8081
PAPERLESS_API_URL=http://localhost:8010
REDMINE_API_URL=http://localhost:8011
KEYCLOAK_API_URL=http://localhost:8082

# Im Livebetrieb auf true setzen: /ready ist dann nur bei mit Credentials
# konfiguriertem und erreichbarem ERPNext und Paperless erfolgreich.
READINESS_REQUIRE_INTEGRATIONS=false

# FLOWAGENTS (Agentenplattform). Vor jeder Netzwerknutzung ersetzen und in
# services/agent_orchestrator/config/orchestrator.yaml demo_mode: false setzen.
# Die Werte müssen in Compose (.env) und in der Umgebung des Orchestrators gleich sein.
FLOW_AGENT_RM_SECRET=local-agent-rm-secret-change-before-network-use
FLOW_AGENTS_API_SECRET=local-agents-api-secret-change-before-network-use
# Je Agentenrolle ein FLOWGATE-Schlüssel (nur das Modellprofil der Rolle), z. B.:
# FLOW_AGENT_GATEWAY_KEY_ANFORDERUNGEN=…
# FLOW_AGENT_GATEWAY_KEY_CODEPRUEFUNG=…
# Dienst-Token zwischen FLOWAI-Werkzeug „Entwicklung & Repository“ (dev-mcp) und Plattform-API
FLOW_DEV_MCP_TOKEN=local-dev-mcp-token-change-before-network-use
