      {"name": "Arbeitsvertrag", "match": "Arbeitsvertrag", "matching_algorithm": 3, "is_insensitive": true},
      {"name": "Entgeltabrechnung", "match": "Entgeltabrechnung", "matching_algorithm": 3, "is_insensitive": true}
    ],
    "storage_paths": [
      {"name": "DMS-Eingang", "path": "Eingang/{{ created_year }}/{{ created_month }}", "match": "", "matching_algorithm": 0, "is_insensitive": true}
    ]
  },
  "protected_areas": [
    {
      "name": "HR-Recruiting",
      "access_group": "DMS-Bereich-HR-Recruiting",
      "tag": "Bereich/HR-Recruiting",
      "tag_color": "#8a3b12",
      "storage_path": "Personal/Bewerbungen/{{ created_year }}/{{ created_month }}",
      "filename_patterns": ["Bewerbung_*", "Lebenslauf_*", "Arbeitsvertrag_*"],
      "order": 40
    },
    {
      "name": "HR-Payroll",
      "access_group": "DMS-Bereich-HR-Payroll",
      "tag": "Bereich/HR-Payroll",
      "tag_color": "#6f2c91",
      "storage_path": "Personal/Entgeltabrechnungen/{{ created_year }}/{{ created_month }}",
      "filename_patterns": ["Entgeltabrechnung_*", "Lohnabrechnung_*"],
      "order": 41
    }
  ],
