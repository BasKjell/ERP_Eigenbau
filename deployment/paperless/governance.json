    "tags": [
      {"name": "Status/Entwurf", "color": "#6c757d", "match": "", "matching_algorithm": 0, "is_insensitive": true, "is_inbox_tag": false},
      {"name": "Status/In Prüfung", "color": "#0d6efd", "match": "", "matching_algorithm": 0, "is_insensitive": true, "is_inbox_tag": false},
