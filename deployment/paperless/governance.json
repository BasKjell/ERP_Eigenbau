      {"name": "Spezifikation", "match": "Spezifikation", "matching_algorithm": 3, "is_insensitive": true},
      {"name": "Kundenauftrag", "match": "Auftragsbestätigung", "matching_algorithm": 1, "is_insensitive": true},
      {"name": "Bestellung", "match": "Bestellung", "matching_algorithm": 3, "is_insensitive": true},
